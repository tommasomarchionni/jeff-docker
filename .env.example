# ---- Required --------------------------------------------------------
# Generate with: openssl rand -hex 32   (comma-separate multiple keys)
JEFF_API_KEYS=
# Only for local tests: start without auth
JEFF_ALLOW_NO_AUTH=false

# ---- Image / build ---------------------------------------------------
JEFF_DOCKER_TAG=latest
JEFF_REF=main
UV_EXTRAS=dev

# ---- Network (local/prebuilt only) -----------------------------------
JEFF_BIND=127.0.0.1
JEFF_HOST_PORT=8000

# ---- Model -----------------------------------------------------------
JEFF_MODEL_ID=knowledgator/gliformer-large-v1
JEFF_MODEL_PATH=/models/gliformer-large-v1
JEFF_MODEL_REVISION=main
JEFF_DOWNLOAD_MODEL=true
JEFF_FORCE_MODEL_DOWNLOAD=false
HF_TOKEN=

# ---- Runtime (CPU-first) ---------------------------------------------
JEFF_DEVICE=cpu
JEFF_BACKEND=torch
JEFF_QUANT=
JEFF_THREADS=6
JEFF_MAX_BATCH=8
JEFF_MAX_WAIT_MS=10
JEFF_WARMUP=1

# ---- Protection ------------------------------------------------------
JEFF_RATE_LIMIT_RPS=4
JEFF_RATE_LIMIT_BURST=8

# ---- Dokploy resource limits -----------------------------------------
JEFF_CPU_LIMIT=8
JEFF_MEM_LIMIT=10g
