# =====================================================================
# jeff-docker configuration
# Copy to .env (Compose) or paste into Dokploy -> Environment.
# Full reference: https://tommasomarchionni.github.io/jeff-docker/environment-variables/
# Empty values = upstream Jeff default.
# =====================================================================

# ---- Authentication (REQUIRED) --------------------------------------
# One or more comma-separated bearer keys. Generate with: openssl rand -hex 32
JEFF_API_KEYS=
# Start without authentication. Local tests ONLY, never on a reachable host.
JEFF_ALLOW_NO_AUTH=false

# ---- Image / build ---------------------------------------------------
# GHCR tag for prebuilt/Dokploy (pin a version in production, e.g. 0.2.0)
JEFF_DOCKER_TAG=latest
# Local builds only: upstream Jeff git ref, extras, PyTorch wheel index
JEFF_REF=main
UV_EXTRAS=onnx
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# ---- Container / network (local + prebuilt compose) ------------------
JEFF_CONTAINER_NAME=jeff
JEFF_VOLUME_PREFIX=jeff
JEFF_BIND=127.0.0.1
JEFF_HOST_PORT=8000

# ---- Resource limits -------------------------------------------------
JEFF_CPU_LIMIT=8
JEFF_MEM_LIMIT=10g

# ---- Model -----------------------------------------------------------
JEFF_MODEL_ID=knowledgator/gliformer-large-v1
JEFF_MODEL_PATH=/models/gliformer-large-v1
# Pin a commit SHA for reproducible deployments
JEFF_MODEL_REVISION=main
JEFF_DOWNLOAD_MODEL=true
JEFF_FORCE_MODEL_DOWNLOAD=false
# Name/aliases exposed by /v1/models (upstream default: gliformer-large-v1 + jev-latest,jev)
JEFF_MODEL_NAME=
JEFF_MODEL_ALIASES=
# Only for private/gated Hugging Face repos or higher rate limits
HF_TOKEN=

# ---- Runtime (CPU-first) ---------------------------------------------
JEFF_DEVICE=cpu
# torch | onnx  (onnx exports the encoder once into <model>/onnx)
JEFF_BACKEND=torch
# fp32 | int8 (onnx only)
JEFF_QUANT=
JEFF_ONNX_PATH=
JEFF_DTYPE=
JEFF_THREADS=6
JEFF_WARMUP=true

# ---- Batching and request limits -------------------------------------
JEFF_MAX_BATCH=8
JEFF_MAX_WAIT_MS=10
JEFF_MAX_QUEUE=
JEFF_RATE_LIMIT_RPS=4
JEFF_RATE_LIMIT_BURST=8
JEFF_MAX_QUESTIONS=
JEFF_MAX_LABELS=
JEFF_MAX_STATE_CHARS=

# ---- Prompt / calibration (advanced) ---------------------------------
# single | single_named | yes_no   (use "single" with gliformer-base-v1)
JEFF_NOUL_MODE=
# none | nouls | all
JEFF_ISOLATE=
# kv | json | values
JEFF_STATE_FORMAT=
JEFF_TEMPERATURE=
